import time
import board

# HP206F Constants & Commands
I2C_ADDR = 0x76            # Default Grove I2C address for HP206F
SOFT_RESET = 0x06          # Soft reset command
START_CONVERT = 0x40       # Base conversion command
OSR_1024 = 0x02 << 2       # Over-sampling rate configuration (1024)
READ_P = 0x30              # Read pressure register
READ_T = 0x32              # Read temperature register

class GroveHP206F:
    def __init__(self, i2c_bus, address=I2C_ADDR):
        self.i2c = i2c_bus
        self.address = address
        self.reset()
        
    def reset(self):
        # Reset the sensor
        while not self.i2c.try_lock():
            pass
        try:
            self.i2c.writeto(self.address, bytes([SOFT_RESET]))
        finally:
            self.i2c.unlock()
        time.sleep(0.1) # Wait for configuration after reset

    def _read_raw_24bit(self, reg_cmd):
        # 1. Tell the sensor to start a high-accuracy conversion
        while not self.i2c.try_lock():
            pass
        try:
            self.i2c.writeto(self.address, bytes([START_CONVERT | OSR_1024]))
        finally:
            self.i2c.unlock()
            
        time.sleep(0.03) # Wait 30ms for calculation to finish
        
        # 2. Request 3 bytes of data from the designated register
        buffer = bytearray(3)
        while not self.i2c.try_lock():
            pass
        try:
            self.i2c.writeto(self.address, bytes([reg_cmd]))
            self.i2c.readfrom_into(self.address, buffer)
        finally:
            self.i2c.unlock()
            
        # Combine 3 bytes into a single 24-bit unsigned integer
        val = (buffer[0] << 16) | (buffer[1] << 8) | buffer[2]
        
        # Convert two's complement if the value is negative
        if val & 0x800000:
            val -= (1 << 24)
        return val

    @property
    def pressure(self):
        # Returns barometric pressure in hPa (hectopascals)
        raw_p = self._read_raw_24bit(READ_P)
        return raw_p / 100.0

    @property
    def temperature(self):
        # Returns temperature in °C
        raw_t = self._read_raw_24bit(READ_T)
        return raw_t / 100.0

# Initialize I2C interface
i2c = board.I2C()
sensor = GroveHP206F(i2c)

print("HP206F Barometer Initialized successfully!")

while True:
    try:
        p = sensor.pressure
        t = sensor.temperature
        
        print(f"Pressure   : {p:.2f} hPa")
        print(f"Temperature: {t:.2f} °C")
        print("-" * 25)
    except Exception as e:
        print("Error reading sensor:", e)
        
    time.sleep(2)
